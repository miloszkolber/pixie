{
	"name": "@pixie_ai/pixie-assistant",
	"version": "0.1.0",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/miloszkolber/pixie.git",
		"directory": "pi/pixie-assistant"
	},
	"type": "module",
	"bin": {
		"pixie-assistant": "src/main.ts"
	},
	"files": [
		"src"
	],
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		"./capabilities": "./src/capabilities.ts",
		"./mcp": "./src/extensions/pi-mcp-adapter.ts"
	},
	"scripts": {
		"start": "bun src/main.ts",
		"typecheck": "tsc --noEmit",
		"build": "bun build src/main.ts --target=bun --outdir=dist"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "0.85.1",
		"@earendil-works/pi-coding-agent": "0.85.1",
		"proper-lockfile": "4.1.2",
		"yaml": "2.9.0"
	},
	"devDependencies": {
		"typebox": "1.3.7",
		"@juicesharp/rpiv-ask-user-question": "2.9.0",
		"@juicesharp/rpiv-todo": "2.9.0",
		"@juicesharp/rpiv-web-tools": "2.9.0",
		"@mjakl/pi-subagent": "3.0.1",
		"@signetai/connector-pi": "0.157.3",
		"pi-mcp-adapter": "2.32.1",
		"@types/bun": "catalog:",
		"typescript": "catalog:",
		"@types/proper-lockfile": "4.1.4"
	}
}
