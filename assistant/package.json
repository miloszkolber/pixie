{
	"name": "@pixie_ai/pixie-assistant",
	"version": "0.1.0",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/miloszkolber/pixie.git",
		"directory": "assistant"
	},
	"type": "module",
	"bin": {
		"pixie-assistant": "src/main.ts"
	},
	"files": [
		"src",
		"patches"
	],
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		"./capabilities": "./src/capabilities.ts",
		"./mcp-admin-bridge": "./src/extensions/mcp-admin-bridge.ts"
	},
	"scripts": {
		"start": "bun src/main.ts",
		"typecheck": "tsc --noEmit",
		"build": "bun build src/main.ts --target=bun --outdir=dist",
		"postinstall": "node patches/apply-patches.mjs"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "0.85.1",
		"@earendil-works/pi-coding-agent": "0.85.1",
		"proper-lockfile": "4.1.2",
		"yaml": "2.9.0"
	},
	"devDependencies": {
		"typebox": "1.3.7",
		"@signetai/connector-pi": "0.157.3",
		"@types/bun": "catalog:",
		"typescript": "catalog:",
		"@types/proper-lockfile": "4.1.4"
	}
}
