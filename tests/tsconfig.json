{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"types": ["bun"],
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"paths": {
			"@/*": ["../webui/src/*"],
			"@pixie/shared": ["../src/shared/index.ts"],
			"@pixie/shared/*": ["../src/shared/*"]
