{
	"name": "pixie",
	"private": true,
	"type": "module",
	"devDependencies": {
		"@modelcontextprotocol/sdk": "1.30.0"
	},
	"scripts": {
		"build": "bun run build:pixie_web",
		"build:pixie_web": "bun run build:web && bun run build:go",
		"build:pixie_assistant": "bun build --target=bun --outfile dist/pixie_assistant.js ../assistant/src/serve.ts",
		"build:pixie_cli": "CGO_ENABLED=0 go build -trimpath -o dist/pixie_cli ./cmd/pixie-cli",
		"build:pixie": "CGO_ENABLED=0 go build -trimpath -o dist/pixie ./cmd/pixie",
		"build:pixie_full": "CGO_ENABLED=0 go build -trimpath -o dist/pixie_full ./cmd/pixie-full",
		"build:go": "go build -trimpath -o dist/pixie_web ./cmd",
		"build:release": "bun scripts/build-release.ts",
		"dev:web": "bun --filter @pixie/web dev",
		"build:web": "bun --filter @pixie/web build",
		"mewa:check": "bun --filter @pixie/web mewa:check",
		"typecheck": "bun --filter @pixie/shared typecheck && bun --filter @pixie/web typecheck && tsc --noEmit -p tests/tsconfig.json && bun --filter @pixie_ai/pixie-assistant typecheck",
		"test": "bun test tests && go test ./...",
		"check:filenames": "bun scripts/check-filenames.ts",
		"check:coverage": "bun scripts/check-coverage.ts",
		"check:performance": "bun scripts/check-performance.ts",
		"check:docs": "bun scripts/check-docs.ts",
		"generate:contracts": "bun scripts/generate-contracts.ts",
		"check:contracts": "bun scripts/check-contracts.ts",
		"lint": "bun run check:filenames && biome check . ../assistant ../shared ../package.json ../biome.json",
		"format": "biome check --write . ../assistant ../shared ../package.json ../biome.json",
		"check:deps": "bun scripts/check-catalog.ts"
	}
}
