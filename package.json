{
	"name": "pixie-workspace",
	"private": true,
	"packageManager": "bun@1.4.0",
	"workspaces": {
		"packages": [
			"package",
			"package/contracts",
			"package/webui",
			"assistant"
		],
		"catalog": {
			"@tailwindcss/cli": "4.3.3",
			"@types/bun": "1.4.0",
			"micromark": "4.0.2",
			"micromark-extension-gfm": "3.0.0",
			"svelte": "5.57.0",
			"svelte-check": "4.7.6",
			"tailwindcss": "4.3.3",
			"typescript": "6.0.3"
		}
	},
	"type": "module",
	"devDependencies": {
		"@biomejs/biome": "2.5.0",
		"@juicesharp/rpiv-ask-user-question": "2.9.0",
		"@juicesharp/rpiv-todo": "2.9.0",
		"@juicesharp/rpiv-web-tools": "2.9.0",
		"@mjakl/pi-subagent": "3.0.1",
		"pi-mcp-adapter": "2.32.1",
		"typescript": "catalog:"
	},
	"trustedDependencies": [
		"@biomejs/biome"
	],
	"scripts": {
		"build": "bun run --cwd package build",
		"build:assistant": "bun run --cwd package build:assistant",
		"build:go": "bun run --cwd package build:go",
		"build:host": "bun run --cwd package build:host",
		"build:release": "bun run --cwd package build:release",
		"build:web": "bun run --cwd package build:web",
		"check:deps": "bun run --cwd package check:deps",
		"check:coverage": "bun run --cwd package check:coverage",
		"check:filenames": "bun run --cwd package check:filenames",
		"check:docs": "bun run --cwd package check:docs",
		"generate:contracts": "bun run --cwd package generate:contracts",
		"check:contracts": "bun run --cwd package check:contracts",
		"check:parity": "bun run --cwd package check:parity",
		"dev:web": "bun run --cwd package dev:web",
		"format": "bun run --cwd package format",
		"lint": "bun run --cwd package lint",
		"mewa:check": "bun run --cwd package mewa:check",
		"test": "bun run --cwd package test",
		"typecheck": "bun run --cwd package typecheck"
	},
	"patchedDependencies": {
		"@earendil-works/pi-coding-agent@0.85.1": "assistant/patches/pi-coding-agent-0.85.1-extensions-export.patch",
		"@mjakl/pi-subagent@3.0.1": "patches/@mjakl%2Fpi-subagent@3.0.1.patch"
	}
}
