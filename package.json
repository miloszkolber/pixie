{
	"name": "pixie-workspace",
	"private": true,
	"packageManager": "bun@1.4.0",
	"workspaces": {
		"packages": [
			"web",
			"shared",
			"web/webui",
			"assistant"
		],
		"catalog": {
			"@types/bun": "1.4.0",
			"micromark": "4.0.2",
			"micromark-extension-gfm": "3.0.0",
			"svelte": "5.57.0",
			"svelte-check": "4.7.6",
			"typescript": "6.0.3"
		}
	},
	"type": "module",
	"devDependencies": {
		"@biomejs/biome": "2.5.0",
		"typescript": "catalog:"
	},
	"trustedDependencies": [
		"@biomejs/biome"
	],
	"scripts": {
		"build": "bun run build:pixie_web",
		"build:pixie_web": "bun run --cwd web build:pixie_web",
		"build:pixie_cli": "bun run --cwd web build:pixie_cli",
		"build:pixie": "bun run --cwd web build:pixie",
		"build:pixie_assistant": "bun run --cwd assistant build:pixie_assistant",
		"build:go": "bun run --cwd web build:go",
		"build:release": "bun x bun@1.4.0 run web/scripts/build-release.ts",
		"build:release:amd64": "bun x bun@1.4.0 run web/scripts/build-release.ts --architecture amd64",
		"build:release:arm64": "bun x bun@1.4.0 run web/scripts/build-release.ts --architecture arm64",
		"build:release:merge": "bun x bun@1.4.0 run web/scripts/build-release.ts --merge",
		"build:web": "bun run --cwd web build:web",
		"check:deps": "bun run --cwd web check:deps",
		"check:coverage": "bun run --cwd web check:coverage",
		"check:filenames": "bun run --cwd web check:filenames",
		"check:docs": "bun run --cwd web check:docs",
		"generate:contracts": "bun run --cwd web generate:contracts",
		"check:contracts": "bun run --cwd web check:contracts",
		"dev:web": "bun run --cwd web dev:web",
		"format": "bun run --cwd web format",
		"lint": "bun run --cwd web lint",
		"mewa:check": "bun run --cwd web mewa:check",
		"test": "bun run --cwd web test && bun run --cwd assistant test",
		"typecheck": "bun run --cwd web typecheck"
	}
}
