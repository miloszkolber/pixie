{
	"name": "pixie",
	"private": true,
	"type": "module",
	"devDependencies": {
		"@modelcontextprotocol/sdk": "1.30.0"
	},
	"scripts": {
		"build": "bun run build:web && bun run build:go",
		"build:go": "go build -trimpath -o dist/pixie ./cmd",
		"dev:web": "bun --filter @pixie/web dev",
		"build:web": "bun --filter @pixie/web build",
		"mewa:check": "bun --filter @pixie/web mewa:check",
		"typecheck": "bun --filter @pixie/contracts typecheck && bun --filter @pixie/web typecheck && tsc --noEmit -p tests/tsconfig.json && bun --filter @pixie_ai/pixie-assistant typecheck",
		"test": "bun test tests && go test ./...",
		"check:filenames": "bun scripts/check-filenames.ts",
		"lint": "bun run check:filenames && biome check . ../assistant ../package.json ../biome.json",
		"format": "biome check --write . ../assistant ../package.json ../biome.json",
		"check:deps": "bun scripts/check-catalog.ts",
		"check:parity": "bun test tests/pi-native-parity"
	}
}
