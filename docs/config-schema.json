{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://pixie.local/schemas/config-schema.json",
	"$comment": "Code generated by generate-config-schema.ts; DO NOT EDIT.",
	"title": "Pixie configuration schemas",
	"description": "Documentation and drift detection for the private Pixie JSON configuration files. Runtime fail-closed validation remains authoritative.",
	"$defs": {
		"controllerConfig": {
			"$comment": "pixie_web --config; controller-only mode rejects agentDir and piExecutable.",
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"host": {
					"type": "string"
				},
				"port": {
					"type": "integer",
					"minimum": 1,
					"maximum": 65535
				},
				"dataDir": {
					"type": "string"
				},
				"staticDir": {
					"type": "string"
				},
				"mode": {
					"type": "string",
					"enum": [
						"controller"
					]
				},
				"agentDir": {
					"type": "string"
				},
				"piExecutable": {
					"type": "string"
				}
			}
		},
		"assistantConfig": {
			"$comment": "pixie_cli/pixie_full --assistant-config; every field is required.",
			"type": "object",
			"additionalProperties": false,
			"required": [
				"agentDir",
				"allowSelfRestart",
				"host",
				"port",
				"schemaVersion"
			],
			"properties": {
				"agentDir": {
					"type": "string",
					"minLength": 1
				},
				"allowSelfRestart": {
					"type": "boolean"
				},
				"host": {
					"type": "string",
					"minLength": 1
				},
				"port": {
					"type": "integer",
					"minimum": 1,
					"maximum": 65535
				},
				"schemaVersion": {
					"type": "integer",
					"const": 2
				}
			}
		}
	}
}
