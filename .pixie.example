# Pixie configuration source. Compose reads this file when present
# (overlaying shell environment); explicit `environment:` entries in
# docker-compose.yaml take precedence over values set here.

# Existing host directory holding Pixie application state, owned by UID/GID 1000.
# The container mounts it whole at /var/lib/pixie.
PIXIE_DATA_PATH=/absolute/path/to/pixie-data

# Shared with the Pi host service. Pi always runs on loopback on the host,
# outside the container. Set only the port; Pixie dials ws://127.0.0.1:<port>/pi.
# Deprecated override: PIXIE_PI_URL must still be a loopback ws(s) URL.
PIXIE_PI_PORT=3284
PIXIE_PI_SECRET_KEY=replace-with-a-random-pi-secret

# Required: a strong private token authenticating the in-process MCP publisher
# (module catalog and built-in MCP servers). The controller refuses to start
# without it, and it must differ from PIXIE_TOKEN.
PIXIE_MCP_TOKEN=replace-with-a-random-mcp-token

# Web UI, API and in-process MCP publisher share one listener on this port.
PIXIE_CONTROLLER_PORT=7312

# Optional controller login; remote binding always requires an exact public
# origin plus either this login or explicit no-auth acknowledgement.
# Trusted LAN without app auth relies on the firewall (UFW Core Shared TCP).
# Only origins matching PIXIE_PUBLIC_ORIGIN are accepted for mutations.
# For an HTTPS public origin behind a cleartext TLS-terminating proxy, enable
# PIXIE_AUTH_ENABLED and list only the proxy peer IPs/CIDRs here. The proxy
# must rewrite Host to the exact public authority and set
# X-Forwarded-Proto=https; other forwarded headers remain ignored. Leave unset
# for direct HTTPS, loopback HTTP, or the documented unauthenticated LAN mode.
PIXIE_AUTH_ENABLED=false
# PIXIE_TOKEN=replace-with-a-random-controller-token
# PIXIE_CONTROLLER_HOST=127.0.0.1
# PIXIE_ALLOW_UNAUTHENTICATED_REMOTE=false
# PIXIE_PUBLIC_ORIGIN=https://pixie.example.com
# PIXIE_TRUSTED_PROXY_CIDRS=127.0.0.1/32

# Retired and ignored (warning at startup): PIXIE_MCP_MODULES,
# PIXIE_MCP_DISABLED_MODULES. Toggle modules in Tools instead.

# Browser is not configured through the environment. Pixie stores one setting
# under Settings -> Browser and registers it in Pi's MCP configuration; Pi
# reaches the operator-chosen endpoint directly. The optional `pixie-browser`
# Compose service is a separate deployment, not a `pixie` dependency.

# Non-Docker runs only: the Compose service pins PIXIE_DATA_DIR to the
# container layout below; plain binaries default to $XDG_DATA_HOME/pixie.
# PIXIE_STATIC_DIR is a development-only override (release binaries embed the UI).
# PIXIE_DATA_DIR=/var/lib/pixie
# PIXIE_STATIC_DIR=/path/to/pixie/webui/dist
