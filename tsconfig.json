{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"resolveJsonModule": true,
		"types": ["bun"],
		"lib": ["ESNext"],
		"paths": {
			"@pixie/shared": ["./src/shared/index.ts"]
		}
	},
	"include": ["src/**/*.ts"]
}
